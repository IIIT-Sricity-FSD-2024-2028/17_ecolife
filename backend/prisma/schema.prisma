// ============================================================================
// TROPOS — CLEAN-SLATE REAL-WORLD PRISMA SCHEMA (PostgreSQL + RLS)
// Audited & Hardened: All relational FKs, retention locks, dual-regime math,
//                     SME single-user flags, and regulatory bounds enforced.
// Standards: GHG Protocol (Corp, Scope 2, Scope 3), India CEA v22.0,
//            SEBI BRSR Core (2023/122 & 2025/42), BEE CCTS (AR2 / 0.727),
//            MoEFCC Green Credit Programme (Aug 2025), COSO ICSR (2023),
//            ISO 14064-1/3 & ISO/TS 14064-4:2025, ICAI SSAE 3000/3410, ISSA 5000
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

