NODE_ENV=development
PORT=3000

# Auth (session length is a platform setting in the admin Settings page, not an env var)
JWT_SECRET=generate-a-long-random-secret
JWT_ADMIN_SECRET=generate-a-different-long-random-secret

# File uploads (evidence files are limited to 10 MB each, set in code)
UPLOAD_DIR=./uploads

# Security
BCRYPT_SALT_ROUNDS=10

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Organization sign-up screening: only work emails may register an organization.
# Set to false for local testing with Gmail/Yahoo addresses.
ENFORCE_WORK_EMAIL=true

# Deployment hardening
# Number of reverse-proxy hops in front of the API (so rate limits use each client's real IP). Leave unset when not behind a proxy.
# TRUST_PROXY=1
# Swagger UI (/api/docs) is disabled when NODE_ENV=production unless this is true.
# ENABLE_SWAGGER=false
# Seeding in production requires an explicit Super Admin password (demo accounts are skipped).
# SEED_SUPERADMIN_PASSWORD=
# In production JWT_SECRET and JWT_ADMIN_SECRET must be different and at least 32 characters.

# DEMO ONLY: no mailer yet, so password-reset codes are shown on screen instead of emailed.
# Anyone who knows an email address can reset that account while this is true.
# Ignored (always off) when NODE_ENV=production.
DEMO_OTP_RESET=true
