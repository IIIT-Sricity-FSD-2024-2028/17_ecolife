# PostgreSQL (Local PostgreSQL or Supabase Postgres connection string)
# Two connections, on purpose:
#  - MIGRATE_DATABASE_URL: owner/superuser. Used ONLY to create tables, apply security rules and seed data.
#  - DATABASE_URL: the restricted role "tropos_app". The running API uses this, so each company's data stays separate.
MIGRATE_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tropos"
DATABASE_URL="postgresql://tropos_app:CHANGE_ME_APP_PASSWORD@localhost:5432/tropos"
# Password given to tropos_app when `npm run db:setup` creates it. Must match DATABASE_URL above.
APP_DB_PASSWORD="CHANGE_ME_APP_PASSWORD"
# Development only. Lets the API start as a superuser, which switches OFF tenant isolation. Ignored in production.
ALLOW_SUPERUSER_DB="false"

# Server & CORS
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN="http://localhost:5173"

# JWT Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret-of-at-least-32-characters"
# 64 hex characters (32 bytes), used to encrypt sensitive fields. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=""
JWT_EXPIRES_IN="12h"

# Real Email & OTP Dispatch (choose: smtp | resend | console)
# Supports Supabase SMTP, Gmail App Password, Brevo, SendGrid, Postmark, or Resend API
EMAIL_PROVIDER="console"
EMAIL_FROM="Tropos ERP <no-reply@tropos.in>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""

# Evidence File Storage (local SHA-256 disk storage or optional Supabase Storage bucket)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=10
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="tropos-evidence"

# Reset/verify tokens are echoed in API responses ONLY when this is "true" AND NODE_ENV is not production. Keep "false" unless you are testing.
ALLOW_DEV_PREVIEW_TOKENS="false"
# Number of reverse proxies in front of the API (0 when running locally)
TRUST_PROXY=0

# Evidence storage: "local" (disk, UPLOAD_DIR) or "supabase"
STORAGE_PROVIDER="local"

# Billing identity. All of these must be set before the platform can issue a GST invoice; none is assumed.
# Values come from your CA. Leave empty until you have them.
BILLING_SUPPLIER_GSTIN=""
BILLING_SUPPLIER_NAME=""
BILLING_SUPPLIER_ADDRESS=""
BILLING_SAC_CODE=""
BILLING_GST_RATE_PCT=""
BILLING_PAYMENT_TERMS_DAYS=15

# How customers pay while online payment is off (shown on their billing page). Bank/UPI details, or who to contact.
# After the money arrives, a platform admin uses "Mark as paid".
PAYMENT_INSTRUCTIONS=""

# Online payment: "none" or "razorpay". Use Razorpay TEST keys until launch. Never commit real keys.
PAYMENT_PROVIDER="none"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_API_BASE="https://api.razorpay.com/v1"
