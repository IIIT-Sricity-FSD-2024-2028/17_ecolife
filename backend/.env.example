NODE_ENV=development
PORT=3000

# Auth
JWT_SECRET=generate-a-long-random-secret
JWT_EXPIRES_IN=1d
JWT_ADMIN_SECRET=generate-a-different-long-random-secret
JWT_ADMIN_EXPIRES_IN=1d

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Security
DEFAULT_SESSION_TIMEOUT_MIN=30
BCRYPT_SALT_ROUNDS=10

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Organization sign-up screening: only work emails may register an organization.
# Set to false for local testing with Gmail/Yahoo addresses.
ENFORCE_WORK_EMAIL=true
