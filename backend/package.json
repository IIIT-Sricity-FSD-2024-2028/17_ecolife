{
  "name": "tropos-backend",
  "version": "1.0.0",
  "description": "Tropos Carbon Accounting, Resource Analytics & Green Economy ERP Backend (NestJS v12 + Prisma 5 + PostgreSQL RLS + Local OCR + Real Email/OTP)",
  "main": "dist/main.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "db:rls": "tsx prisma/apply-rls.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-large": "tsx prisma/seed-large.ts",
    "db:seed-demo": "tsx prisma/seed-demo.ts",
    "db:setup": "npm run prisma:generate && npm run prisma:migrate && npm run db:rls && npm run db:seed"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/swagger": "^12.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.1",
    "nodemailer": "^10.6.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.21.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdf-parse": "^1.1.4",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.11.10",
    "prisma": "7.10.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "effect": "3.22.5"
  }
}
